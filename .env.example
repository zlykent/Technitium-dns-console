# ---------------------------------------------------------------------------
# Technitium DNS Server base URL used when the browser has not selected a
# server profile yet. The UI can override this per-session via the server
# switcher (see lib/proxy/target.ts for the SSRF guard that validates it).
# ---------------------------------------------------------------------------
TECHNITIUM_API_URL=http://127.0.0.1:5380

# Optional comma-separated allowlist. When set, ONLY these host:port targets may
# be proxied and the permissive guard is disabled. Leave empty for permissive
# mode (loopback / link-local / cloud-metadata addresses are always blocked).
# Example: TECHNITIUM_ALLOWED_TARGETS=127.0.0.1:5380,dns.example.com:5380
TECHNITIUM_ALLOWED_TARGETS=

# Cookie hardening. Must be a random 32+ char string in production.
SESSION_COOKIE_PREFIX=tdns

# Upstream request timeouts (milliseconds).
PROXY_TIMEOUT_JSON_MS=30000
PROXY_TIMEOUT_FILE_MS=120000

# Set to "true" to log a one-line audit record for every proxied call.
PROXY_AUDIT_LOG=true
